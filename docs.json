{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Scouty",
  "description": "Find better-fit prospects, write personal outreach, and turn replies into meetings.",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#3B82F6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "getting-started/accounts-and-projects"
        ]
      },
      {
        "group": "Find prospects",
        "pages": [
          "find-prospects/research-your-company",
          "find-prospects/campaigns-and-targeting",
          "find-prospects/companies-and-contacts",
          "find-prospects/campaign-automation",
          "find-prospects/knowledge"
        ]
      },
      {
        "group": "Send and manage email",
        "pages": [
          "email/drafts-and-sending",
          "email/writing-prompt",
          "email/conversations",
          "email/auto-follow-up",
          "email/analytics"
        ]
      },
      {
        "group": "Meetings",
        "pages": [
          "meetings/google-calendar"
        ]
      },
      {
        "group": "AI apps (MCP)",
        "pages": [
          "ai-apps/connect",
          "ai-apps/tools-and-permissions"
        ]
      },
      {
        "group": "Workspace settings",
        "pages": [
          "settings/people",
          "settings/billing",
          "settings/connected-apps",
          "settings/notifications",
          "settings/custom-domain"
        ]
      },
      {
        "group": "Affiliate program",
        "pages": [
          "affiliates"
        ]
      },
      {
        "group": "Limits and troubleshooting",
        "pages": [
          "help/limits-and-troubleshooting"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open Scouty",
          "href": "https://scouty.to/",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/find-prospects/auto-gtm",
      "destination": "/find-prospects/campaign-automation"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Scouty",
      "href": "https://scouty.to/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Scouty by Nudgen LLC",
        "items": [
          {
            "label": "Nudgen LLC",
            "href": "/index#business-details"
          },
          {
            "label": "Contact support",
            "href": "mailto:contact@scouty.to"
          },
          {
            "label": "Terms of Service",
            "href": "https://scouty.to/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "https://scouty.to/privacy"
          }
        ]
      }
    ]
  }
}
